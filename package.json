{
  "name": "al-jawahira-workstation",
  "version": "5.2.0",
  "description": "Nexa-LMIS Al-Jawahira Electrophysiology Clinical Workstation upgraded with Cloudflare Workers and Cloudflare D1 (Serverless SQLite)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create al-jawahira-db",
    "d1:migrate:local": "wrangler d1 execute al-jawahira-db --local --file=./migrations/0001_initial_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute al-jawahira-db --remote --file=./migrations/0001_initial_schema.sql"
  },
  "keywords": [
    "cloudflare-workers",
    "cloudflare-d1",
    "sqlite",
    "nexa-lmis",
    "electrophysiology",
    "clinical-workstation"
  ],
  "author": "SpringNexa Private Limited",
  "license": "UNLICENSED",
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
